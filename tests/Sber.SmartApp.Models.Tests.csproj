<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup Condition="'$(ModelsPackageVersion)' == ''">
    <ProjectReference Include="..\src\Sber.SmartApp.Models.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(ModelsPackageVersion)' != ''">
    <PackageReference Include="Sber.SmartApp.Models" Version="$(ModelsPackageVersion)" />
  </ItemGroup>

</Project>
